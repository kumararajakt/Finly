# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finly

# Server port
PORT=3000

# Secret used to sign session cookies (change in production)
SESSION_SECRET=change-me

# Local file storage root for documents
FILE_STORAGE_ROOT=./data

# Google Drive (optional, leave blank until configured)
GOOGLE_DRIVE_FOLDER_NAME=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCHEDULE=off
