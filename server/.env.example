# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finly

# Server port
PORT=3000

# Secret used to sign session cookies (min 32 chars; generate with `openssl rand -base64 32`)
SESSION_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Base URL of the API server (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed client origins for CORS (with credentials).
# When unset, the request origin is reflected.
CORS_ORIGIN=

# Resend for OTP emails. Leave unset for dev: OTPs are logged to the server console.
# Create an API key at https://resend.com/api-keys and set the sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM=Finly <onboarding@resend.dev>

# Run pending Drizzle migrations at bootstrap (true/false; default false)
AUTO_MIGRATE=false

# Local file storage root for documents
FILE_STORAGE_ROOT=./data

# Google Drive (optional, leave blank until configured)
GOOGLE_DRIVE_FOLDER_NAME=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCHEDULE=off
