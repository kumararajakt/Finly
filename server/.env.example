# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finly

# Server port
PORT=3000

# Secret used to sign session cookies (min 32 chars; generate with `openssl rand -base64 32`)
SESSION_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Base URL used by Better Auth for OAuth redirects and session cookies.
# IMPORTANT: in dev this must be the CLIENT origin (the Vite dev server, e.g. http://localhost:5173),
# so the OAuth callback and Set-Cookie flow through the Vite proxy to the client.
# For the serverless deploy it is the server origin, and the client origin must then be listed
# in CORS_ORIGIN (it is validated against trustedOrigins for the OAuth callback).
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated list of allowed client origins for CORS (with credentials).
# When unset, the request origin is reflected.
# Also added to Better Auth trustedOrigins for OAuth callback validation.
CORS_ORIGIN=

# OAuth provider credentials (sign in via Google/GitHub).
# Create at https://console.cloud.google.com/apis/credentials and https://github.com/settings/apps
# Authorized redirect URI for each: {BETTER_AUTH_URL}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Run pending Drizzle migrations at bootstrap (true/false; default false)
AUTO_MIGRATE=false
